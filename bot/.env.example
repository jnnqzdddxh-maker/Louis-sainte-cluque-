# Copier ce fichier en .env (jamais committer le .env réel) et remplir.
# Chargé automatiquement si python-dotenv est utilisé par le lanceur, ou à
# exporter dans l'environnement avant de lancer dry_run.py / main.py.

# --- RPC ---------------------------------------------------------------
SOLANA_RPC_URL=
ROBINHOOD_RPC_URL=

# --- Données marché / wallets --------------------------------------------
BIRDEYE_API_KEY=
HELIUS_API_KEY=
BITQUERY_API_KEY=
DEXPAPRIKA_API_KEY=

# --- Clés privées des wallets d'EXÉCUTION ---------------------------------
# UNIQUEMENT nécessaires en mode live. JAMAIS en clair ailleurs que dans un
# .env local non committé (voir .gitignore) ou un vrai gestionnaire de
# secrets. Ne jamais coller une clé privée dans un message, un log, ou une
# issue/PR.
SOLANA_WALLET_PRIVATE_KEY=
ROBINHOOD_WALLET_PRIVATE_KEY=

# --- Confirmation explicite du mode live -----------------------------------
# Ne définir que juste avant un lancement live volontaire. Voir
# README.md section "Passage en live". Ne JAMAIS mettre dans .env si ce
# fichier traîne sur une machine partagée / un serveur toujours actif.
BOT_CONFIRM_LIVE=
